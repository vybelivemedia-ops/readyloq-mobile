{
  "expo": {
    "name": "ReadyLoq",
    "slug": "readyloq-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "readyloq-app",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hgwashingllc.readyloqmobile",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "ReadyLoq uses the camera to capture inspection photos of pest activity and conducive conditions for AI analysis.",
        "NSPhotoLibraryUsageDescription": "ReadyLoq saves and attaches inspection photos to your reports.",
        "NSLocationWhenInUseUsageDescription": "ReadyLoq records the inspection site location to tag your reports.",
        "NSMicrophoneUsageDescription": "Allow ReadyLoq to use the microphone for hands-free inspection notes.",
        "NSBluetoothAlwaysUsageDescription": "ReadyLoq connects to BLE sensors and Meta Ray-Ban smart glasses for hands-free inspection capture and environmental measurement.",
        "NSBluetoothPeripheralUsageDescription": "ReadyLoq uses Bluetooth to pair with smart glasses and measurement sensors.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "fetch",
          "processing"
        ]
      },
      "backgroundModes": [
        "bluetooth-central",
        "fetch",
        "processing"
      ]
    },
    "android": {
      "package": "com.hgwashingllc.readyloqmobile",
      "versionCode": 219,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "readyloq-app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ReadyLoq uses the camera to capture inspection photos for AI analysis.",
          "microphonePermission": "Allow ReadyLoq to use the microphone for hands-free inspection notes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ReadyLoq records the inspection site location to tag your reports."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 26,
            "packagingOptions": {
              "exclude": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow ReadyLoq to use the microphone for hands-free inspection notes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0d1117",
          "sounds": []
        }
      ],
      "expo-background-fetch",
      "expo-mail-composer",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true
        }
      ],
      "./plugins/withFoldableConfigChanges.js",
      "./plugins/withMetaWearables.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7927cf86-2cbd-4c14-9bd5-d43f2beabec8"
      }
    },
    "owner": "hgwashingllc"
  }
}
