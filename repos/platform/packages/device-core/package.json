{
  "name": "@platform/device-core",
  "version": "0.1.0",
  "private": true,
  "description": "Universal hardware abstraction \u2014 every hardware provider (camera, sensor, wearable, IoT) implements DeviceProvider; the inspection engine and stream engine never know the manufacturer",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@platform/core": "workspace:*",
    "@platform/shared-types": "workspace:*",
    "@platform/provider-registry": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "types": "./dist/index.d.ts"
}
