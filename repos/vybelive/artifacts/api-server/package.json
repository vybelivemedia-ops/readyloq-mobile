{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "jobs:lifecycle": "node --enable-source-maps ./dist/jobs/lifecycle.mjs",
    "jobs:autonomy-tick": "node --enable-source-maps ./dist/jobs/autonomyTick.mjs",
    "jobs:scheduled-posts-tick": "node --enable-source-maps ./dist/jobs/scheduledPostsTick.mjs",
    "seed:mission-control": "MISSION_CONTROL_SEED_CLI=1 node --enable-source-maps ./dist/jobs/seedMissionControl.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/build-info": "workspace:*",
    "@workspace/db": "workspace:*",
    "agora-token": "^2.0.5",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.10",
    "openai": "^6.45.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^22.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.9"
  }
}
